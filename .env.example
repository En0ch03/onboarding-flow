# Copy this file to .env and point it at your API.
# .env itself is never committed.
#
# The path segment is part of the base address, exactly as the contract defines it.
# iOS simulator:     http://localhost:4000/api/v1
# Android emulator:  http://10.0.2.2:4000/api/v1
# Physical device:   http://<your machine's LAN address>:4000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
