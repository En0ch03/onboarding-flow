# Optional. Nothing here is required: the API address ships with the app in
# app.json under extra.apiUrl, so a fresh clone runs with no configuration.
#
# Set this only to point the app at a different API - a staging host, a branch
# deployment, a backend you are writing yourself. When it is set it always
# wins.
#
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
#
# Set this to run against the server that ships with this repository instead.
# It takes no address: the app derives one from the machine already serving the
# bundle, because "localhost" means the phone on a phone and the emulator
# inside an emulator. 1 and true turn it on; anything else, including 0, is
# off.
#
# EXPO_PUBLIC_USE_LOCAL_API=1
#
# Two endpoints are not part of the contract: the option lists and image
# upload. A server can satisfy the contract in full and still not serve them.
# Set this to keep those two on the mock server while everything else goes to
# the real one. Left unset, it follows the address above and the app talks to
# a single server.
#
# EXPO_PUBLIC_STANDIN_API_URL=http://192.168.1.24:4000/api/v1
